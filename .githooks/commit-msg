#!/usr/bin/env sh
set -eu

msg_file="$1"
first_line="$(head -n 1 "$msg_file")"

case "$first_line" in
    Merge\ *|Revert\ *|fixup!\ *|squash!\ *)
        exit 0
        ;;
esac

if ! printf '%s\n' "$first_line" | grep -qE '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._-]+\))?!?: .+'; then
    printf '%s\n' "commit-msg: invalid Conventional Commit subject: $first_line" >&2
    printf '%s\n' "expected: <type>(<scope>): <description>" >&2
    exit 1
fi
